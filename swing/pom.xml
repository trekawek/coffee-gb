<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>coffee-gb</artifactId>
        <groupId>eu.rekawek.coffeegb</groupId>
        <version>1.7.15</version>
    </parent>

    <artifactId>swing</artifactId>
    <version>1.7.15</version>

    <name>swing</name>
    <build>
        <finalName>coffee-gb-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>embed-reviewed-legal-inventory</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>
                                ${project.build.outputDirectory}/META-INF/coffee-gb/legal
                            </outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.parent.basedir}/packaging/resources/legal</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>eu.rekawek.coffeegb.swing.MainKt</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Title>Coffee GB</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                    <finalName>coffee-gb-${project.version}</finalName>
                    <outputTimestamp>${project.build.outputTimestamp}</outputTimestamp>
                </configuration>
                <executions>
                    <execution>
                        <id>make-target-neutral-app</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/app.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>true</attach>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <workDirectory>${project.build.directory}/assembly-work/app</workDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>make-assembly</id>
                        <!-- this is used for inheritance merges -->
                        <phase>package</phase>
                        <!-- bind to the packaging phase -->
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <workDirectory>${project.build.directory}/assembly-work/universal</workDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.2</version>
                <configuration>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <outputName>coffee-gb-${project.version}-sbom.cdx</outputName>
                    <outputFormat>json</outputFormat>
                    <schemaVersion>1.6</schemaVersion>
                    <projectType>application</projectType>
                    <includeBomSerialNumber>false</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeProvidedScope>false</includeProvidedScope>
                    <includeSystemScope>false</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                    <includeLicenseText>false</includeLicenseText>
                    <skipAttach>true</skipAttach>
                    <skipNotDeployed>false</skipNotDeployed>
                </configuration>
                <executions>
                    <execution>
                        <id>make-app-sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/NativeArtifactIT.java</include>
                        <include>**/NativePackageIT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <coffeeGbUniversalJar>${project.build.directory}/coffee-gb-${project.version}.jar</coffeeGbUniversalJar>
                        <coffeeGbAppJar>${project.build.directory}/coffee-gb-${project.version}-app.jar</coffeeGbAppJar>
                        <coffeeGbSbom>${project.build.directory}/coffee-gb-${project.version}-sbom.cdx.json</coffeeGbSbom>
                        <coffeeGbPackagingResources>${project.parent.basedir}/packaging/resources</coffeeGbPackagingResources>
                        <coffeeGbExpectedVersion>${project.version}</coffeeGbExpectedVersion>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-core-java</artifactId>
            <version>9.0.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.rekawek.coffeegb</groupId>
            <artifactId>controller</artifactId>
            <version>1.7.15</version>
        </dependency>
        <dependency>
            <groupId>eu.rekawek.coffeegb</groupId>
            <artifactId>core</artifactId>
            <version>1.7.15</version>
        </dependency>
        <!-- OpenCV with bundled natives for the webcam camera source; unlike the old
             sarxos/bridj stack this ships Apple-Silicon (osx arm64) natives, and Linux /
             Windows / x86_64, so a self-built jar captures on the machine that built it. -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>
        <!-- SDL2 via JNA with bundled natives (Linux / Windows / macOS incl. arm64) for
             game-controller input: SDL's mapping database covers PS3/PS4/PS5, Xbox,
             Switch Pro and most generic pads, plus force feedback for the rumble carts. -->
        <dependency>
            <groupId>io.github.libsdl4j</groupId>
            <artifactId>libsdl4j</artifactId>
            <version>2.28.4-1.6</version>
        </dependency>
    </dependencies>
</project>
